# --- Nexus local secrets (copy to .env) ---
ENV=development
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=nexus
DATABASE_URL=******postgres:5432/nexus

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434

JWT_SECRET=replace-with-64-char-random-string
# Cookies: Secure is on by default outside development and cannot be disabled there. SameSite: lax | strict | none (none needs Secure).
# COOKIE_SECURE=true   # default: true outside development, false in development
COOKIE_SAMESITE=lax

# Reverse proxies allowed to set X-Forwarded-For / X-Real-IP (comma-separated IPs/CIDRs).
# Empty = never trust forwarded headers. In docker-compose, trust the internal network where Caddy runs.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Caddy (production): real hostnames enable automatic TLS; set HSTS once HTTPS works.
# CHAT_SITE_ADDRESS=chat.example.com
# ADMIN_SITE_ADDRESS=admin.example.com
# HSTS_VALUE=max-age=31536000; includeSubDomains

ADMIN_BOOTSTRAP_EMAIL=admin@nexus.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeNow!

CHAT_ORIGIN=http://localhost:8080
ADMIN_ORIGIN=http://localhost:8081
# Explicit origins only ("*" is rejected); must be https outside development.
API_CORS_ORIGINS=http://localhost:8080,http://localhost:8081

OLLAMA_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava:7b
ENABLE_VISION=false
EMBED_DIM=768
MAX_UPLOAD_MB=50
