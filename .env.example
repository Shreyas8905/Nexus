# --- Nexus local secrets (copy to .env) ---
ENV=development
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=nexus
DATABASE_URL=******postgres:5432/nexus

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434

JWT_SECRET=replace-with-64-char-random-string
COOKIE_SECURE=false

ADMIN_BOOTSTRAP_EMAIL=admin@nexus.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeNow!

CHAT_ORIGIN=http://localhost:8080
ADMIN_ORIGIN=http://localhost:8081
API_CORS_ORIGINS=http://localhost:8080,http://localhost:8081

OLLAMA_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava:7b
ENABLE_VISION=false
EMBED_DIM=768
MAX_UPLOAD_MB=50

# --- LLM resilience (backend/app/services/llm_client.py) ---
# LLM_PROVIDER=groq            # default: ollama
# GROQ_API_KEY=
# GROQ_FALLBACK_MODELS=llama-3.1-8b-instant   # comma-separated, tried after GROQ_LLM_MODEL
LLM_FALLBACK_TO_OLLAMA=true    # last resort when every Groq model fails
LLM_TIMEOUT_SECONDS=180
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2              # retries per model for rate-limit / timeout / unavailable
LLM_RETRY_BACKOFF_SECONDS=0.5  # doubles each retry: 0.5s, 1s, 2s ...
LOG_LEVEL=INFO
